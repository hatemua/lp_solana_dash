# Copy to .env on the server and fill in. Never commit .env (it is in .gitignore).

# --- database / cache (internal network only)
POSTGRES_USER=lp
POSTGRES_PASSWORD=
POSTGRES_DB=lp

# --- Solana RPC (Helius key goes in RPC_URL; public RPC is only a backup)
RPC_URL=
RPC_BACKUP_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# --- indexer
WATCH_POOLS_N=10
LOG_LEVEL=INFO

# --- later milestones (leave empty until then)
API_CORS_ORIGINS=https://lp.joulity.com
NEXT_PUBLIC_API_URL=https://lp.api.joulity.com
ADMIN_WALLETS=
MCP_BEARER_TOKEN=
BOT_MODE=paper
BOT_WALLET_KEYPAIR_PATH=
