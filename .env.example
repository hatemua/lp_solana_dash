# Copy to .env on the server and fill in. Never commit .env (it is in .gitignore).

# --- database / cache (internal network only)
POSTGRES_USER=lp
POSTGRES_PASSWORD=
POSTGRES_DB=lp

# --- Solana RPC (Helius key goes in RPC_URL; public RPC is only a backup)
RPC_URL=
RPC_BACKUP_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=

# --- indexer
WATCH_POOLS_N=10
LOG_LEVEL=INFO

# --- later milestones (leave empty until then)
API_CORS_ORIGINS=https://lp.joulity.com
NEXT_PUBLIC_API_URL=https://lp.api.joulity.com
ADMIN_WALLETS=
# MCP: OAuth via the accounts on lp.joulity.com; this static token is optional (scripts), >= 24 chars if set
MCP_BEARER_TOKEN=
PUBLIC_API_URL=https://lp.api.joulity.com
WEB_URL=https://lp.joulity.com
SIGNUP_OPEN=true
BOT_MODE=paper
BOT_STRATEGIES=pro_spot,pro_spot_wide,pro_bid
BOT_POSITION_USD=100
BOT_MAX_OPEN=3
BOT_WALLET_KEYPAIR_PATH=
